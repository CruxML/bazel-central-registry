module(
    name = "bazel_esp32",
    version = "0.0.2",
    compatibility_level = 0,
)

bazel_dep(name = "rules_shell", version = "0.7.1")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "platforms", version = "0.0.11")

register_toolchains("//toolchain:cc-toolchain-xtensa")

esp32_deps = use_extension("//:deps.bzl", "esp32_deps")
use_repo(esp32_deps, "arduino_esp32", "xtensa_esp32_elf_linux64")
